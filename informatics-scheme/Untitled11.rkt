; Определяем основную процедуру `ref`, которая принимает последовательность данных (список, вектор или строку),
; индекс и опционально элемент для вставки.
(define (ref data ind . el)

  ; Проверяем, что индекс не отрицательный
  (and
   (>= ind 0)  ; Проверяем, что индекс больше или равен нулю (допустимый индекс)
   
   ; Начинаем условную конструкцию, которая проверяет тип данных
   (cond
     ((pair? data)  ; Проверяем, является ли data списком (пара)
      (if (null? el)  ; Проверяем, передан ли элемент для вставки (el пуст)
          (and (< ind (length data)) (list-ref data ind))  ; Если нет элемента, возвращаем элемент списка по индексу
          (if (<= ind (length data))  ; Если индекс находится в пределах длины списка
              ; Вставляем элемент в нужную позицию
              (cons (car (take data ind))  ; Берем элементы списка до указанного индекса
                    (cons (car el)  ; Вставляем новый элемент
                          (cdr (take data ind))))  ; Добавляем оставшиеся элементы после вставки
              #f)))  ; Если индекс выходит за пределы, возвращаем #f

     ((vector? data)  ; Проверяем, является ли data вектором
      (if (null? el)  ; Если нет элемента для вставки
          (and (< ind (vector-length data)) (vector-ref data ind))  ; Возвращаем элемент вектора по индексу
          (if (<= ind (vector-length data))  ; Если индекс допустимый
              ; Создаем новый вектор на 1 элемент больше
              (let ((result (make-vector (+ 1 (vector-length data)))))  ; Создаем новый вектор с увеличенной длиной
                ; Итератор по индексам
                (do ((i 0 (+ i 1)))  ; Инициализируем переменную i с 0 и увеличиваем на 1 в каждой итерации
                    ((= i (+ ind 1)))  ; Завершаем, когда i равно индексу для вставки + 1
                  (if (< i ind)  ; Если текущий индекс меньше индекса для вставки
                      (vector-set! result i (vector-ref data i))  ; Копируем элемент из исходного вектора
                      (if (= i ind)  ; Если текущий индекс равен индексу для вставки
                          (vector-set! result i (car el))  ; Вставляем элемент в новый вектор
                          (vector-set! result i (vector-ref data (- i 1)))  ; Копируем оставшиеся элементы
                      ))))
                result)  ; Возвращаем новый вектор с вставленным элементом
              #f)))  ; Если индекс выходит за пределы, возвращаем #f

     ((string? data)  ; Проверяем, является ли data строкой
      (if (null? el)  ; Если нет элемента для вставки
          (and (< ind (string-length data)) (string-ref data ind))  ; Возвращаем символ строки по индексу
          (if (and (char? (car el)) (<= ind (string-length data)))  ; Проверяем, является ли элемент символом и индекс допустимым
              (let ((L (string->list data)))  ; Преобразуем строку в список символов и сохраняем в L
                ; Вставляем символ
                (cons (list->string (append (take L ind)  ; Составляем новую строку из элементов
                                             (list (car el))  ; Вставляем новый символ
                                             (drop L ind)))  ; Добавляем оставшиеся элементы после вставки
                      ))  ; Возвращаем новую строку
              #f)))))  ; Если условия не выполняются, возвращаем #f
