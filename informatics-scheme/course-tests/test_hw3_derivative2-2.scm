(load "2024-ib/derivative.scm")
(load "unit-test.scm")

(define ie (interaction-environment))

(define-syntax derivative-test
  (syntax-rules ()
    ((derivative-test argument expected call-arg)
     (test (round_1e-6 (eval `(let ((x call-arg))
                                ,(derivative 'argument))
                             ie))
           (round_1e-6 (eval '(let ((x call-arg))
                                expected)
                             ie))))))

(define PI (* 4 (atan 1)))

(define (round_1e-6 x)
  (/ (round (* x 1e6)) 1e6))


(display "\n-=РОБОТ-ПРОВЕРЯЛЬЩИК ВЫПОЛНЯЕТ ТЕСТЫ ДЛЯ ПРОИЗВОДНОЙ=-\n\n")


(define tests
  (list (derivative-test 2 0 10.25217)
        (derivative-test x 1 10.25217)
        (derivative-test (- x) -1 10.25217)
        (derivative-test (* 1 x) 1 10.25217)
        (derivative-test (* -1 x) -1 10.25217)
        (derivative-test (* -4 x) -4 10.25217)
        (derivative-test (* x 10) 10 10.25217)
        (derivative-test (- (* 2 x) 3) 2 10.25217)
        (derivative-test (expt x 10) (* 10 (expt x 9)) 10.25217)
        (derivative-test (* 2 (expt x 5)) (* 10 (expt x 4)) 10.25217)
        (derivative-test (expt x -2) (* -2 (expt x -3)) 10.25217)
        (derivative-test (expt 5 x) (* (log 5) (expt 5 x)) 10.25217)
        (derivative-test (cos x) (- (sin x)) (/ PI 2))
        (derivative-test (sin x) (cos x) 0)
        (derivative-test (sin x) (cos x) 0.25217)
        (derivative-test (exp x) (exp x) 10.25217)
        (derivative-test (* 2 (exp x)) (* 2 (exp x)) 10.25217)
        (derivative-test (* 2 (exp (* 2 x))) (* 4 (exp (* 2 x))) 10.25217)
        (derivative-test (log x) (/ 1 x) 7.25217)
        (derivative-test (* (log x) 3) (/ 3 x) 7.25217)
        (derivative-test (+ (expt x 3) (* x x)) (+ (* 3 x x) (* 2 x)) 10.25217)
        (derivative-test (- (* 2 (expt x 3)) (* 2 (expt x 2)))
                         (- (* 6 x x) (* 4 x))
                         10.25217)
        (derivative-test (/ 3 x) (/ -3 (* x x)) 7.25217)
        (derivative-test (/ 3 (* 2 (expt x 2))) (/ -3 (expt x 3)) 7.25217)
        (derivative-test (* 2 (sin x) (cos x))
                         (* 2 (cos (* 2 x)))
                         (/ PI 3))
        (derivative-test (* 2 (exp x) (sin x) (cos x))
                         (* (exp x) (+ (* 2 (cos (* 2 x))) (sin (* 2 x))))
                         0.25217)
        (derivative-test (cos (* 2 (expt x 2)))
                         (* -4 x (sin (* 2 (expt x 2))))
                         5.25217)
        (derivative-test (sin (log (expt x 2)))
                         (/ (* 2 (cos (log (expt x 2)))) x)
                         15.25217)
        (derivative-test (+ (sin (+ x x)) (cos (* x 2 x)))
                         (+ (* 2 (cos (* 2 x))) (* -4 (sin (* x 2 x)) x))
                         10.25217)
        (derivative-test (* (sin (+ x x)) (cos (* x 2 x)))
                         (+ (* (- 1 (* 2 x)) (cos (* 2 x (- 1 x))))
                            (* (+ 1 (* 2 x)) (cos (* 2 x (+ 1 x)))))
                         5.25217)
        (derivative-test (* x x x x)
			 (* 4 x x x)
                         5.25217)))


(define **test-succeed-25217** (run-tests tests))
